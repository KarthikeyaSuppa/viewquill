# ── Node / frontend ──────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.local
.eslintcache

# ── Python / sidecar ─────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
*.spec.bak

# ── Rust / Tauri ─────────────────────────────────────────────
target/
apps/desktop/src-tauri/binaries/
apps/desktop/src-tauri/resources/ollama/
Cargo.lock.orig

# ── App data / never commit user or derived data ─────────────
*.sqlite
*.sqlite3
*.db
app-data/
media/
audio/
*.quillproj

# ── Secrets (never; keys live in OS credential vault only) ────
.env.*
*.pem
*.key
secrets.json

# ── OS / editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
